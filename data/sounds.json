":"c","hard":false,"contrasts":["n-ng"],"examples":[{"word":"nose","i":0,"j":1,"sounds":["n","oʊ","z"]},{"word":"sun","i":2,"j":3,"sounds":["s","ʌ","n"]},{"word":"name","i":0,"j":1,"sounds":["n","eɪ","m"]},{"word":"can","i":2,"j":3,"sounds":["k","æ","n"]}],"tip":"Like “n”: the tongue tip on the roof behind your teeth."},{"sym":"ŋ","group":"c","kind":"c","hard":true,"contrasts":["n-ng"],"examples":[{"word":"sing","i":2,"j":4,"sounds":["s","ɪ","ŋ"]},{"word":"long","i":2,"j":4,"sounds":["l","ɔ","ŋ"]},{"word":"king","i":2,"j":4,"sounds":["k","ɪ","ŋ"]},{"word":"think","i":3,"j":4,"sounds":["θ","ɪ","ŋ","k"]}],"tip":"An “n” from the back of the mouth, with no g at the end: sing, not sing-g."},{"sym":"l","group":"c","kind":"c","hard":false,"contrasts":["r-l"],"examples":[{"word":"lip","i":0,"j":1,"sounds":["l","ɪ","p"]},{"word":"feel","i":3,"j":4,"sounds":["f","iː","l"]},{"word":"light","i":0,"j":1,"sounds":["l","aɪ","t"]},{"word":"milk","i":2,"j":3,"sounds":["m","ɪ","l","k"]}],"tip":"Tongue tip on the roof behind your top teeth. At the end (feel) it stays slightly raised."},{"sym":"r","group":"c","kind":"c","hard":true,"contrasts":["r-l"],"examples":[{"word":"red","i":0,"j":1,"sounds":["r","ɛ","d"]},{"word":"right","i":0,"j":1,"sounds":["r","aɪ","t"]},{"word":"road","i":0,"j":1,"sounds":["r","oʊ","d"]},{"word":"bread","i":1,"j":2,"sounds":["b","r","ɛ","d"]}],"tip":"Not a rolled or tapped r: curl your tongue back and touch nothing. Lips slightly round."},{"sym":"j","group":"c","kind":"c","hard":false,"contrasts":[],"examples":[{"word":"yes","i":0,"j":1,"sounds":["j","ɛ","s"]},{"word":"year","i":0,"j":1,"sounds":["j","ɪr"]},{"word":"you","i":0,"j":1,"sounds":["j","uː"]},{"word":"yellow","i":0,"j":1,"sounds":["j","ɛ","l","oʊ"]}],"tip":"Like “y” at the start of a word."},{"sym":"w","group":"c","kind":"c","hard":true,"contrasts":["w-v"],"examples":[{"word":"wet","i":0,"j":1,"sounds":["w","ɛ","t"]},{"word":"wine","i":0,"j":1,"sounds":["w","aɪ","n"]},{"word":"white","i":0,"j":2,"