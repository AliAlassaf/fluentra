xed “uh”. cup is not cop."},{"sym":"ə","group":"v","kind":"v","hard":true,"contrasts":[],"examples":[{"word":"about","i":0,"j":1,"sounds":["ə","b","aʊ","t"]},{"word":"banana","i":5,"j":6,"sounds":["b","ə","n","æ","n","ə"]},{"word":"lemon","i":3,"j":4,"sounds":["l","ɛ","m","ə","n"]},{"word":"sofa","i":3,"j":4,"sounds":["s","oʊ","f","ə"]}],"tip":"The most common sound in English: every weak syllable shrinks to a tiny “uh”. The spelling misleads you."},{"sym":"aɪ","group":"v","kind":"d","hard":false,"contrasts":[],"examples":[{"word":"my","i":1,"j":2,"sounds":["m","aɪ"]},{"word":"time","i":1,"j":2,"sounds":["t","aɪ","m"]},{"word":"bike","i":1,"j":2,"sounds":["b","aɪ","k"]},{"word":"night","i":1,"j":4,"sounds":["n","aɪ","t"]}],"tip":"Starts with an open “ah” and glides to ee, as in “eye”."},{"sym":"aʊ","group":"v","kind":"d","hard":false,"contrasts":[],"examples":[{"word":"now","i":1,"j":3,"sounds":["n","aʊ"]},{"word":"house","i":1,"j":3,"sounds":["h","aʊ","s"]},{"word":"mouth","i":1,"j":3,"sounds":["m","aʊ","θ"]},{"word":"down","i":1,"j":3,"sounds":["d","aʊ","n"]}],"tip":"Starts with an open “ah” and glides to oo, as in “ow!”."},{"sym":"ɔɪ","group":"v","kind":"d","hard":false,"contrasts":[],"examples":[{"word":"boy","i":1,"j":3,"sounds":["b","ɔɪ"]},{"word":"coin","i":1,"j":3,"sounds":["k","ɔɪ","n"]},{"word":"toy","i":1,"j":3,"sounds":["t","ɔɪ"]},{"word":"voice","i":1,"j":3,"sounds":["v","ɔɪ","s"]}],"tip":"Starts with rounded lips and glides to ee, as in “boy”."},{"sym":"ɝ","group":"v","kind":"r","hard":false,"contrasts":["er-ar"],"examples":[{"word":"bird","i":1,"j":3,"sounds":["b","ɝ","d"]},{"word":"word","i":1,"j":3,"sounds":["w","ɝ","d"]},{"word":"nurse","i":1,"j":3,"sounds":["n","ɝ","s"]},{"word":"learn","i":1,"j":4,"sounds":["l","ɝ","n"]}],"tip":"Mouth almost closed, tongue curls from the very start. Same sound for ir, or, ur, ear."},{"sym":"ɚ","group":"v","kind":"r","hard":true,"contrasts":[],"examples":[{"word":"teacher","i":5,"j":7,"sounds":["t","iː","tʃ","ɚ"]}